{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "overrides": [
    {
      "files": [
        "tests/**/*.ts",
        "scripts/compare-checkpoint.mjs"
      ],
      "rules": {
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
